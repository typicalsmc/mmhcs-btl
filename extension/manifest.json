{
  "manifest_version": 3,
  "name": "PKI Lab — Trình diễn Chrome",
  "version": "1.0.0",
  "minimum_chrome_version": "102",
  "description": "Trình diễn bảy bước PKI bằng điều hướng Chrome thật, tách biệt với tham chiếu OpenSSL.",
  "key": "",
  "permissions": ["storage", "webRequest"],
  "host_permissions": ["http://127.0.0.1/*", "https://login.payroll.test/*", "https://other.payroll.test/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Mở bảng trình diễn PKI"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://127.0.0.1:8765"}
}
